rules_version = '2';

// Sainam Technology — Cloud Storage security rules.
//
// Browsers upload directly to Storage. These rules enforce ownership, content type
// and size. The server re-verifies path, size and type from object metadata before
// any file is attached to a Firestore record (see src/server/storage.ts).

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.get('role', 'STUDENT');
    }

    function isStaff() {
      return signedIn() && role() in ['MENTOR', 'ADMIN', 'SUPER_ADMIN'];
    }

    function isAdmin() {
      return signedIn() && role() in ['ADMIN', 'SUPER_ADMIN'];
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function verified() {
      return request.auth.token.email_verified == true;
    }

    function under(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    function isDocument() {
      return request.resource.contentType in [
        'application/pdf',
        'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
      ];
    }

    function isSubmissionFile() {
      return isImage() || request.resource.contentType in [
        'application/pdf',
        'application/zip',
        'application/x-zip-compressed',
        'text/plain',
        'text/markdown'
      ];
    }

    function isStaffFile() {
      return isSubmissionFile() || request.resource.contentType in [
        'application/vnd.openxmlformats-officedocument.presentationml.presentation',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
      ];
    }

    // Submission ids are `${assignmentId}_${uid}`.
    function ownsSubmission(submissionId) {
      return signedIn() && submissionId.matches('^[A-Za-z0-9]+_' + request.auth.uid + '$');
    }

    // Default deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /users/{uid}/profile/{fileName} {
      allow read: if isOwner(uid) || isStaff();
      allow create, update: if isOwner(uid) && isImage() && under(2);
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/resume/{fileName} {
      allow read: if isOwner(uid) || isStaff();
      allow create, update: if isOwner(uid) && verified() && isDocument() && under(5);
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/projects/{projectId}/{fileName} {
      allow read: if isOwner(uid) || isStaff();
      allow create, update: if isOwner(uid) && verified() && isImage() && under(5);
      allow delete: if isOwner(uid);
    }

    match /submissions/{submissionId}/{fileName} {
      allow read: if ownsSubmission(submissionId) || isStaff();
      allow create, update: if ownsSubmission(submissionId) && verified() && isSubmissionFile() && under(10);
      allow delete: if ownsSubmission(submissionId);
    }

    match /assignments/{assignmentId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isStaff() && isStaffFile() && under(20);
      allow delete: if isStaff();
    }

    match /programs/{programId}/resources/{fileName} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && isStaffFile() && under(20);
      allow delete: if isAdmin();
    }

    // Generated server-side only.
    match /certificates/{certificateId}/{fileName} {
      allow read, write: if false;
    }
  }
}
