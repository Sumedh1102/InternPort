# ---------------------------------------------------------------------------
# Sainam Technology — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, certificate QR codes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Firebase web app config (public; safe to expose to the browser) --------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (SERVER ONLY — never prefix with NEXT_PUBLIC_) -------
# Option A: service account fields (escape newlines in the key as \n)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Option B: Application Default Credentials (Cloud Run / App Hosting / gcloud auth)
# FIREBASE_ADMIN_USE_ADC=true
# Optional explicit bucket (defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET)
# FIREBASE_ADMIN_STORAGE_BUCKET=

# Comma-separated emails auto-promoted to SUPER_ADMIN on first verified sign-in.
# Prefer `npm run set-role -- you@example.com SUPER_ADMIN` and leave this empty.
SUPER_ADMIN_EMAILS=

# --- AI (SERVER ONLY) --------------------------------------------------------
# AI_PROVIDER: gemini | anthropic | mock | none
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Scheduled jobs ----------------------------------------------------------
# Shared secret for /api/cron/session-reminders (send as "Authorization: Bearer …")
CRON_SECRET=

# --- Local development with the Firebase Emulator Suite ----------------------
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
