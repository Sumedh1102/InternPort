# Local development against the Firebase Emulator Suite (no real project, no secrets).
# Usage: cp .env.emulator .env.local && npm run emulators   (then, in another shell) npm run seed:demo && npm run dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-sainam.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-sainam
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
AI_PROVIDER=mock
CRON_SECRET=local-cron-secret
# Uploads need a Supabase project (or `supabase start`); leave empty to run without uploads.
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
